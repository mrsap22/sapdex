# Copy to .env for local development: `npm run dev` reads it. Never commit a real .env.
# In production, set these as host variables (Railway → Variables), never in a file.
# Every value is checked at startup; a bad value stops the server.

# production | development | test. Unset means production.
NODE_ENV=development

# Port to listen on. Railway sets this itself.
PORT=8787

# Folder for orders, caches and logs. Required in production (/data on Railway).
DATA_DIR=data

# Number of proxies in front of the server. 1 on Railway, 0 locally. Required in production.
TRUST_PROXY_HOPS=0

# The provider's partner key, from partners.near-intents.org. Server only: never
# commit it and never paste it anywhere shared. Private routing needs it, and with
# it set private routing is on. Left empty, the site runs with public swaps only.
ONECLICK_API_KEY=

# How swaps are routed at the provider: basic (its private routing) or public.
# Left empty it is basic when ONECLICK_API_KEY is set, and public when it is not:
# the provider answers private quotes only to a partner with a key. Written out as
# basic with no key, production does not start; development starts and says so in its log.
PRIVACY_MODE=

# Most calls per minute to the swap provider.
ONECLICK_MAX_PER_MIN=300

# SaplingDex's fee on a swap routed in public, in basis points (100 = 1%), 0 to 300.
# Left empty it is 0: SaplingDex takes no fee, and no fee of ours is sent with a quote.
# The provider's own 0.20% applies either way. Above 0, the provider keeps half of what is set.
FEE_BPS=

# The same for a privately routed swap. Left empty it is 0. Above 0, the provider
# leaves it whole and adds its own beside it.
FEE_BPS_PRIVATE=

# Public address that would receive a fee of ours. Needed, and read, only while FEE_BPS or
# FEE_BPS_PRIVATE is above 0: in production it is then required, in the mixed-case form the
# wallet shows, and must be a normal wallet you hold the key for.
FEE_RECIPIENT=

# true stops new quotes and orders. Defaults to true in production.
SWAPS_PAUSED=false

# Local development only: pretend orders from a built-in practice provider.
# The server then listens on this machine only.
PROVIDER_STUB=false

# Whether visitors are refused by their country or region: off or on. Left empty it is off:
# nobody is refused for where they are, and the region database is never downloaded.
REGION_BLOCK=

# Read only while REGION_BLOCK is on: extra countries to block, as two-letter codes. Adds to the built-in list.
BLOCKED_COUNTRIES=

# The Stats page: on or off. Left empty it is on. Off, the site has no link to it and its address is no page.
STATS_PAGE=

# Add gas (a second, small order beside a swap that delivers the receiving chain's own coin): on or off.
# Left empty it is on, wherever swaps are routed privately. Off, the swap card never offers it and no gas order is made.
ADD_GAS=

# RPC endpoints, server only. Public defaults are used when unset.
BSC_RPC_URL=
ETH_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# The site's own coin: its mint address on Solana, as Sapling shows it. Optional. When set, the
# site has its token page and the home page's token section.
TOKEN_ADDRESS=
# Whether a real swap has shown that ZEC sent to a unified Zcash address with no transparent part
# arrives shielded: "unproven" or "proven". Left empty it is "unproven", and no page says that ZEC
# arrives shielded. Set "proven" only after the test has shown it.
ZEC_SHIELDED=
# Where the two icons in the header and footer lead: X and GitHub. Both https links.
# None is built in: left empty, that icon is not shown.
X_URL=
GITHUB_URL=
# More chains never to offer on the site, by the provider's chain code, separated by commas.
# Adds to the built-in list (abs); it cannot remove from it.
EXCLUDED_CHAINS=
# One support contact (an email address or an https link). Needed before swaps are switched on
# in production: the server refuses SWAPS_PAUSED=false without it.
SUPPORT_CONTACT=
# The site's own address (no path), for example https://example.org. None is built in. With it, a link
# to the site shared in a chat or a post shows the share image, and each page names its own address.
SITE_URL=

# Where operator alerts are posted (a Slack- or Discord-style webhook). Server only.
ALERT_WEBHOOK_URL=
